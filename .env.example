# Copy this file to ".env" and fill in your values.
# Get a free Gemini API key at: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Vision model (change only if Google renames it — see README)
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to test the full flow without a key (returns a sample prompt)
MOCK_MODE=false

# Port for local runs (hosts like Render set PORT automatically)
PORT=3000
